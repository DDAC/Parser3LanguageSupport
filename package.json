{
	"name": "parser3-language-support",
	"displayName": "Parser3 Language Support",
	"description": "Parser3 language support: syntax highlighting, go to definition, symbols, documenting comments",
	"version": "1.6.0",
	"publisher": "DAC",
	"icon": "images/icon.png",
	"engines": {
		"vscode": "^1.57.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets",
		"Other"
	],
	"keywords": [
		"parser3",
		"parser3-ext",
		"parser3ext",
		"parser3 ext",
		"Parser 3"
	],
	"preview": false,
	"galleryBanner": {
		"color": "#eff1f3",
		"theme": "light"
	},
	"contributes": {
		"languages": [
			{
				"id": "parser3ext",
				"aliases": [
					"parser3ext",
					"parser3ext",
					"parser3-ext"
				],
				"extensions": [
					".p",
					".bp",
					".pp"
				],
				"configuration": "./parser3ext.lang-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "parser3ext",
				"scopeName": "source.parser3ext",
				"path": "./syntaxes/Parser3ext.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "parser3ext",
				"path": "./snippets/snippets.json"
			}
		],
		"keybindings": [
			{
				"command": "parser3ext.commentAwareTabShift",
				"key": "Tab",
				"when": "editorTextFocus && editorLangId == parser3ext"
			},
			{
				"key": "ctrl+k ctrl+r",
				"command": "editor.action.insertSnippet",
				"when": "editorTextFocus && editorLangId == parser3ext",
				"args": {
					"langId": "parser3ext",
					"name": "WrapInRegion"
				}
			}
		],
		"commands": [
			{
				"command": "parser3ext.commentAwareTabShift",
				"title": "Parser3: Performs comment-aware tab shift which does not move comment `#` symbols"
			},
			{
				"command": "parser3ext.addDocumentingComment",
				"title": "Parser3: Add Documenting Comment"
			},
			{
				"command": "parser3ext.addDocumentingCommentWithRemarks",
				"title": "Parser3: Add Documenting Comment With Remarks"
			},
			{
				"command": "parser3ext.remSelection",
				"title": "Parser3: Rem selection"
			},
			{
				"command": "parser3ext.commentSelection",
				"title": "Parser3: Comment selection"
			},
			{
				"command": "parser3ext.uncommentSelection",
				"title": "Parser3: Uncomment selection"
			},
			{
				"command": "parser3ext.goToMethodDeclaration",
				"title": "Parser3: Go to specified method declaration"
			},
			{
				"command": "parser3ext.rebuildIndex",
				"title": "Parser3: Rebuild navigation index"
			}
		],
		"configuration": {
			"title": "Parser3 Language Support Config",
			"properties": {
				"parser3ext.settings.remCommentSuffix": {
					"type": [
						"string"
					],
					"default": "aaa",
					"description": "Sets the symbol which should be printed after rem comment '^rem{' upon 'parser3ext.remSelection' command invocation"
				},
				"parser3ext.settings.commentSymbolSuffix": {
					"type": [
						"string"
					],
					"default": "",
					"description": "Sets the symbol which should be printed after comment '#' symbol upon 'parser3ext.commentSelection' command invocation"
				},
				"parser3ext.settings.allowCommentAwareTabCommentsShift": {
					"type": "boolean",
					"default": false,
					"description": "Allow comment-aware TAB to shift commented strings."
				},
				"parser3ext.settings.forceCursorOnTheLineStart": {
					"type": "boolean",
					"default": true,
					"description": "Move the cursor on the line start upon InsertDocumentingHeader invocation. If set to false and invoked - the warning will be displayed and nothing happens."
				},
				"parser3ext.settings.disableGoToMethodListSorting": {
					"type": "boolean",
					"default": false,
					"description": "Disable method signature lexicographic sorting when showing GoToMethod picker."
				},
				"parser3ext.navigation.include": {
					"type": "string",
					"default": "**/*.{p,bp,pp}",
					"description": "Glob of files indexed for Go to Definition and workspace symbols."
				},
				"parser3ext.navigation.exclude": {
					"type": "string",
					"default": "**/{node_modules,.git,.vscode-test}/**",
					"description": "Glob of files excluded from the navigation index."
				},
				"parser3ext.navigation.ignoredMethods": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"if",
						"for",
						"while",
						"foreach",
						"switch",
						"case",
						"rem",
						"use",
						"include",
						"process",
						"try",
						"throw",
						"eval",
						"cache",
						"connect",
						"taint",
						"untaint",
						"apply-taint",
						"return",
						"break",
						"continue",
						"sleep",
						"void",
						"match",
						"replace",
						"split",
						"join",
						"trim",
						"lower",
						"upper",
						"left",
						"right",
						"mid",
						"pos",
						"length",
						"int",
						"double",
						"bool",
						"format",
						"save",
						"load",
						"sql",
						"add",
						"delete",
						"count",
						"keys",
						"hash",
						"array",
						"string",
						"table",
						"sort",
						"select",
						"menu",
						"offset",
						"line",
						"columns",
						"flip",
						"json",
						"xml",
						"contains",
						"at",
						"unique",
						"reverse",
						"exists",
						"append",
						"sub",
						"set",
						"fields",
						"text",
						"print",
						"file",
						"exec",
						"copy",
						"move",
						"find",
						"list",
						"create",
						"foreach",
						"intersect",
						"union",
						"csv",
						"base64",
						"md5",
						"crypt",
						"sha1",
						"uuid",
						"trace",
						"dump",
						"debug",
						"locals"
					],
					"description": "Method names never searched across the whole project when the receiver type is unknown (Parser3 built-ins)."
				},
				"parser3ext.settings.allowedEmptyLinesCount": {
					"type": "number",
					"default": 3,
					"minimum": 0,
					"maximum": 65535,
					"description": "Amount of empty lines between method signature and documenting comment start."
				}
			}
		}
	},
	"activationEvents": [
		"onLanguage:parser3ext"
	],
	"main": "./out/extension",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "^18.19.0",
		"@types/vscode": "^1.57.0",
		"@types/xmldoc": "^1.1.9",
		"@vscode/vsce": "^3.3.2",
		"typescript": "^5.6.3"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/DDAC/Parser3LanguageSupport.git"
	},
	"dependencies": {
		"xmldoc": "^1.3.0"
	}
}
